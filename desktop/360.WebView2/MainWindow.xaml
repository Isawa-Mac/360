<Window x:Class="Trirex360.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="360 Intelligent"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        Background="{DynamicResource WindowBackgroundBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  GlassFrameThickness="0"
                  ResizeBorderThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TitleBarButtonTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource TitleBarButtonPressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Text="360 Intelligent" />

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <TextBlock Width="120" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" Text="v1.0.17" />
        <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="หน้าหลัก" Click="HomeButton_Click">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Data="M12,2.5 L21,10 V21.5 C21,22.3 20.3,23 19.5,23 H4.5 C3.7,23 3,22.3 3,21.5 V10 Z M12,5.1 L5,10.9 V20.5 H9 V14.5 H15 V20.5 H19 V10.9 Z" />
        </Button>
        <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="รีโหลดหน้าเว็บ" Click="ReloadButton_Click">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4.01,7.58 4.01,12 C4.01,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 H17.65 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 H20 V4 L17.65,6.35 Z" />
        </Button>
        <Button x:Name="UpdateButton" Style="{StaticResource TitleBarButtonStyle}" Width="76" Height="24" Margin="4,4,4,4"
                Background="#F97316" Foreground="White" ToolTip="มีเวอร์ชันใหม่" Visibility="Collapsed"
                Click="UpdateButton_Click">
          <TextBlock FontSize="11" FontWeight="SemiBold" Text="UPDATE" />
        </Button>
        <Button Style="{StaticResource TitleBarButtonStyle}" Width="46" ToolTip="ย่อหน้าต่าง" Click="MinimizeButton_Click">
          <TextBlock FontSize="16" Text="&#x2212;" />
        </Button>
        <Button Style="{StaticResource TitleBarButtonStyle}" Width="46" ToolTip="ขยายหน้าต่าง" Click="MaximizeButton_Click">
          <TextBlock FontSize="13" Text="&#x25A1;" />
        </Button>
        <Button Style="{StaticResource TitleBarButtonStyle}" Width="46" ToolTip="ปิดหน้าต่าง" Click="CloseButton_Click">
          <TextBlock FontSize="16" Text="&#x2715;" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <wv2:WebView2CompositionControl x:Name="WebView" DefaultBackgroundColor="#F7F8FA" />

      <Border x:Name="LoadingPanel" Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="360" />
          <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="กำลังเปิดระบบ…" />
        </StackPanel>
      </Border>

      <Border x:Name="ErrorPanel" Background="{DynamicResource WindowBackgroundBrush}" Visibility="Collapsed">
        <StackPanel Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="ไม่สามารถเปิดระบบ 360 ได้" />
          <TextBlock x:Name="ErrorMessage" Margin="0,12,0,20" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
          <Button HorizontalAlignment="Center" MinWidth="120" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Content="ลองอีกครั้ง" Click="RetryButton_Click" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
